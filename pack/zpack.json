{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.3.1/resources/zpack-schema.json",
  "name": "midnight-eclipse",
  "description": "Midnight Eclipse: a glass status bar for komorebi with workspace and layout switching, a taskbar-mirroring app list, live power and media controls, a tray drawer and Quick Settings shortcuts",
  "version": "1.0.0",
  "tags": ["komorebi", "glass", "taskbar"],
  "repositoryUrl": "https://github.com/S0wet0/midnight-eclipse",
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "./index.html",
      "includeFiles": ["**/**"],
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "width": "100%",
          "height": "44px",
          "offsetX": "0px",
          "offsetY": "0px",
          "monitorSelection": { "type": "all" },
          "dockToEdge": { "enabled": false, "edge": null, "windowMargin": "0px" }
        }
      ],
      "transparent": true,
      "focused": false,
      "resizable": false,
      "shownInTaskbar": false,
      "zOrder": "normal",
      "caching": { "defaultDuration": 604800, "rules": [] },
      "privileges": {
        "shellCommands": [
          { "program": "__HELPERS__\\taskbar-mirror.exe", "argsRegex": "^(watch|press [0-9])$" },
          { "program": "__HELPERS__\\power-status.exe", "argsRegex": "^watch$" },
          { "program": "explorer.exe", "argsRegex": "^(ms-actioncenter:|ms-actioncenter:controlcenter/(wifi|bluetooth|cast|project|volume)?)$" },
          { "program": "__KOMOREBIC__", "argsRegex": "^(query focused-workspace-index|focus-workspace [0-8]|change-layout (bsp|columns|rows|vertical-stack|horizontal-stack|ultrawide-vertical-stack|grid|right-main-vertical-stack|scrolling))$" }
        ]
      }
    },
    {
      "name": "tooltip",
      "htmlPath": "./tooltip.html",
      "includeFiles": ["**/**"],
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "width": "1px",
          "height": "1px",
          "offsetX": "0px",
          "offsetY": "0px",
          "monitorSelection": { "type": "primary" },
          "dockToEdge": { "enabled": false, "edge": null, "windowMargin": "0px" }
        }
      ],
      "transparent": true,
      "focused": false,
      "resizable": false,
      "shownInTaskbar": false,
      "zOrder": "top_most",
      "caching": { "defaultDuration": 604800, "rules": [] },
      "privileges": { "shellCommands": [] }
    }
  ]
}
