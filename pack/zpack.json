{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.3.1/resources/zpack-schema.json",
  "name": "midnight-eclipse",
  "description": "Midnight Eclipse: a glass status bar for komorebi",
  "version": "0.1.0",
  "tags": ["komorebi", "glass", "taskbar"],
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "./index.html",
      "includeFiles": ["**/**"],
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "width": "100%",
          "height": "44px",
          "offsetX": "0px",
          "offsetY": "0px",
          "monitorSelection": { "type": "all" },
          "dockToEdge": { "enabled": false, "edge": null, "windowMargin": "0px" }
        }
      ],
      "transparent": true,
      "focused": false,
      "resizable": false,
      "shownInTaskbar": false,
      "zOrder": "normal",
      "caching": { "defaultDuration": 604800, "rules": [] },
      "privileges": {
        "shellCommands": [
          { "program": "C:\\Program Files\\komorebi\\bin\\komorebic.exe", "argsRegex": "^(focus-workspace [0-8]|change-layout (bsp|columns|rows|vertical-stack|horizontal-stack|ultrawide-vertical-stack|grid|right-main-vertical-stack|scrolling))$" }
        ]
      }
    }
  ]
}
